PORT=5000
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/iam_portfolio
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# Email (SendGrid or Gmail)
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_USER=apikey
EMAIL_PASS=your_sendgrid_api_key
EMAIL_FROM=yourname@yourdomain.com
EMAIL_FROM_NAME=IAM Portfolio

# Frontend URL (for unsubscribe links)
FRONTEND_URL=http://localhost:3000

ADMIN_SETUP_KEY=your_one_time_setup_key
